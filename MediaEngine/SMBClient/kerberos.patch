+  public func sessionSetupWithKerberos(username: String, password: String) async throws -> SessionSetup.Response {
+    let kerberos = try KerberosSignIn(username: username, password: password)
+    var setupSessionId: UInt64 = 0
+    var token = try kerberos.next(after: nil)
+    while let sending = token {
+      let request = SessionSetup.Request(
+        messageId: messageId.next(),
+        sessionId: setupSessionId,
+        securityMode: [.signingEnabled],
+        capabilities: [],
+        previousSessionId: 0,
+        securityBuffer: sending
+      )
+      let response = try await send(request)
+      setupSessionId = response.header.sessionId
+      // (The server's last token, with its yes, is the system's proof of who the server is.)
