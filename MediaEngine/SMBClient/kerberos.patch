+      if NTStatus(response.header.status) != .moreProcessingRequired {
+        guard kerberos.isComplete else {
+          throw KerberosSignIn.Failure(what: "The sign-in ended before it was complete.")
+        }
+        // (The session's key is the first sixteen bytes of Kerberos's, as the protocol has it.)
+        var key = try kerberos.sessionKey().prefix(16)
+        if key.count < 16 { key += Data(count: 16 - key.count) }
+        sessionId = setupSessionId
+        isAnonymous = false
+        signingKey = Data(key)
+        return response
+      }
+    }
+    throw KerberosSignIn.Failure(what: "The sign-in ended before the server said yes.")
+  }
+  #endif
